#!/usr/bin/bash
#
# Pattern derived from Bazzite's system_files/deck/shared/usr/libexec/bazzite-autologin
#   https://github.com/ublue-os/bazzite
# Copyright the Universal Blue contributors.
# Licensed under the Apache License, Version 2.0. See LICENSES/Apache-2.0.txt.
#
# MODIFIED FROM THE ORIGINAL:
#   1. Condition swapped from "does /etc/bazzite/desktop_autologin exist" to
#      "is an HDMI connector live".
#   2. Added rewriting of SDDM's state.conf so the greeter defaults to the
#      desktop session when autologin is skipped.
#   3. Added .force / .disable overrides and a DRM-probe wait.
#
# ---------------------------------------------------------------------------
# Conditional autologin: boot into Steam Game Mode only when an HDMI display is
# connected, otherwise present the normal SDDM greeter defaulting to the desktop.
#
# SDDM has no conditional autologin, so this rewrites the drop-in before the
# display manager starts.
#
# How the pieces fit:
#   /usr/lib/sddm/sddm.conf.d/holo.conf          vendor default: Session= + Relogin=
#   /etc/sddm.conf.d/10-gamemode-autologin.conf  written here, ONLY User=, which
#                                                is the on/off switch (SDDM will
#                                                not autologin with empty User)
#   /etc/sddm.conf.d/zz-holo-*.conf              steamos-manager's own session
#                                                switching; named zz- so it
#                                                outranks ours. Not touched here.
#
# Overrides:
#   /etc/gamemode-autologin.force     always autologin, ignore HDMI state
#   /etc/gamemode-autologin.disable   never autologin

set -u

AUTOLOGIN_USER="${AUTOLOGIN_USER:-$(id -nu 1000 2>/dev/null || true)}"
DROPIN="/etc/sddm.conf.d/10-gamemode-autologin.conf"
STATE="/var/lib/sddm/state.conf"

if [[ -r /etc/default/gamemode-session ]]; then
	. /etc/default/gamemode-session
fi

if [[ -z "${DESKTOP_SESSION:-}" ]]; then
	for candidate in plasma.desktop gnome.desktop; do
		if [[ -e "/usr/share/wayland-sessions/${candidate}" ]]; then
			DESKTOP_SESSION="$candidate"; break
		fi
	done
fi
DESKTOP_SESSION_PATH="/usr/share/wayland-sessions/${DESKTOP_SESSION:-plasma.desktop}"

log() { echo "gamemode-autologin: $*"; }

enable_autologin() {
	if [[ -z "$AUTOLOGIN_USER" ]]; then
		log "ERROR: no user found for uid 1000, and AUTOLOGIN_USER unset - refusing"
		return 1
	fi
	mkdir -p "$(dirname "$DROPIN")"
	cat > "$DROPIN" <<INNER
# Generated by gamemode-autologin.service - do not edit, regenerated each boot.
# Session= and Relogin= come from /usr/lib/sddm/sddm.conf.d/holo.conf.
[Autologin]
User=${AUTOLOGIN_USER}
INNER
	log "HDMI present - autologin into Game Mode as ${AUTOLOGIN_USER}"
}

disable_autologin() {
	rm -f "$DROPIN"
	# SDDM preselects the last-used session; without this the greeter would offer
	# Game Mode, which is the thing we just decided not to boot into.
	if [[ -f "$STATE" ]] && [[ -e "$DESKTOP_SESSION_PATH" ]]; then
		sed -i "s|^Session=.*|Session=${DESKTOP_SESSION_PATH}|" "$STATE"
	fi
	log "no HDMI - showing greeter, defaulting to ${DESKTOP_SESSION:-plasma.desktop}"
}

# Wait for DRM connectors to be enumerated. Normally instant; this only guards
# against reading a connector node before the driver has probed it, which would
# look like "disconnected" and silently drop to the greeter.
for _ in {1..25}; do
	compgen -G "/sys/class/drm/card*-HDMI-*/status" >/dev/null && break
	sleep 0.2
done

hdmi_connected() {
	local s
	for s in /sys/class/drm/card*-HDMI-*/status; do
		[[ -r "$s" ]] || continue
		[[ "$(<"$s")" == "connected" ]] && return 0
	done
	return 1
}

if [[ -f /etc/gamemode-autologin.disable ]]; then
	log "override: .disable present"
	disable_autologin
elif [[ -f /etc/gamemode-autologin.force ]]; then
	log "override: .force present"
	enable_autologin
elif hdmi_connected; then
	enable_autologin
else
	disable_autologin
fi
